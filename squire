#!/usr/bin/env bash
# squire — CLI wrapper para o squire
# Uso: squire <comando> [projeto] [opções]

set -euo pipefail

# Resolve o diretório real do script (segue symlinks)
SQUIRE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SQUIRE_VENV="$SQUIRE_DIR/.venv/bin/python"
SQUIRE_STATE_ROOT="${SQUIRE_STATE_ROOT:-/home/ai-debian/squire-state}"
SQUIRE_LOG="/tmp/squire.log"
LOCK_FILE="$SQUIRE_STATE_ROOT/session.lock"

# ── Cores ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()  { echo -e "${CYAN}→${RESET} $*"; }
ok()    { echo -e "${GREEN}✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET} $*"; }
error() { echo -e "${RED}✗${RESET} $*" >&2; }
bold()  { echo -e "${BOLD}$*${RESET}"; }

# ── Helpers ────────────────────────────────────────────────────────
list_projects() {
    ls "$SQUIRE_STATE_ROOT/projects/" 2>/dev/null || echo "(nenhum projeto encontrado)"
}

check_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local pid
        pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid', 0))" 2>/dev/null || echo 0)
        if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
            warn "Sessão ativa (PID $pid). Use 'squire kill' para encerrar."
            return 1
        else
            warn "Lock residual encontrado (processo morto). Limpando..."
            rm -f "$LOCK_FILE"
        fi
    fi
    return 0
}

run_squire() {
    local project="$1"; shift
    SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
        "$SQUIRE_VENV" -u "$SQUIRE_DIR/squire.py" "$project" "$@"
}

# ── Comandos ───────────────────────────────────────────────────────

cmd_run() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1
    info "Iniciando squire para '$project'..."
    run_squire "$project" "$@"
}

cmd_resume() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1

    # Detectar modo bg e flag --quiet nos args restantes
    local bg=false
    local extra=()
    for arg in "$@"; do
        if [[ "$arg" == "bg" ]]; then bg=true
        else extra+=("$arg")
        fi
    done

    if $bg; then
        info "Retomando '$project' em background → $SQUIRE_LOG"
        SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
            nohup "$SQUIRE_VENV" -u "$SQUIRE_DIR/squire.py" "$project" --resume "${extra[@]+"${extra[@]}"}" \
            > "$SQUIRE_LOG" 2>&1 &
        local pid=$!
        ok "Rodando com PID $pid"
        echo -e "  Acompanhe com: ${CYAN}squire log${RESET}"
    else
        info "Retomando '$project' do checkpoint..."
        run_squire "$project" --resume "${extra[@]+"${extra[@]}"}"
    fi
}

cmd_bg() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1
    info "Iniciando '$project' em background → $SQUIRE_LOG"
    SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
        nohup "$SQUIRE_VENV" -u "$SQUIRE_DIR/squire.py" "$project" "$@" \
        > "$SQUIRE_LOG" 2>&1 &
    local pid=$!
    ok "Rodando com PID $pid"
    echo -e "  Acompanhe com: ${CYAN}squire log${RESET}"
}

cmd_dry() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    info "Dry-run para '$project' (sem execução real)..."
    run_squire "$project" --dry-run "$@"
}

cmd_log() {
    if [[ ! -f "$SQUIRE_LOG" ]]; then
        error "Nenhum log encontrado em $SQUIRE_LOG"; exit 1
    fi
    tail -f "$SQUIRE_LOG"
}

cmd_status() {
    bold "=== Estado do squire ==="
    echo ""

    # Lock
    if [[ -f "$LOCK_FILE" ]]; then
        local pid holder
        pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid',0))" 2>/dev/null || echo 0)
        holder=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('holder','?'))" 2>/dev/null || echo "?")
        if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
            ok "Sessão ativa: $holder (PID $pid)"
        else
            warn "Lock residual (processo morto): $holder"
        fi
    else
        info "Nenhuma sessão ativa"
    fi

    echo ""
    bold "=== Projetos ==="
    for proj_dir in "$SQUIRE_STATE_ROOT/projects"/*/; do
        local proj
        proj=$(basename "$proj_dir")
        local status tasks_done tasks_total
        status=$(python3 -c "
import json, pathlib
p = pathlib.Path('$proj_dir/project.json')
if p.exists():
    d = json.loads(p.read_text())
    print(d.get('status','?'))
else:
    print('?')
" 2>/dev/null || echo "?")
        tasks_done=$(python3 -c "
import json, pathlib
p = pathlib.Path('$proj_dir/tasks.json')
if p.exists():
    d = json.loads(p.read_text())
    done = sum(1 for t in d.get('tasks',[]) if t.get('status') == 'completed')
    total = len(d.get('tasks',[]))
    print(f'{done}/{total}')
else:
    print('?/?')
" 2>/dev/null || echo "?/?")
        echo -e "  ${BOLD}$proj${RESET}  status=${CYAN}$status${RESET}  tasks=${tasks_done}"
    done

    echo ""
    bold "=== Rate limit ==="
    python3 -c "
import json, pathlib, datetime
for proj_dir in pathlib.Path('$SQUIRE_STATE_ROOT/projects').iterdir():
    cp = proj_dir / 'checkpoint.json'
    if not cp.exists(): continue
    d = json.loads(cp.read_text())
    rl = d.get('rate_limit', {})
    calls = rl.get('claude_code_calls_this_window', 0)
    maxc  = rl.get('max_calls_per_window', 10)
    ws    = rl.get('window_started_at', '')
    wm    = rl.get('window_duration_minutes', 30)
    if ws:
        wst = datetime.datetime.fromisoformat(ws)
        exp = wst + datetime.timedelta(minutes=wm)
        rem = max(0, (exp - datetime.datetime.utcnow()).total_seconds())
        print(f'  {proj_dir.name}: {calls}/{maxc} calls  (janela reseta em {rem/60:.1f}min)')
    else:
        print(f'  {proj_dir.name}: {calls}/{maxc} calls')
" 2>/dev/null || info "Sem checkpoint disponível"
}

cmd_kill() {
    if [[ ! -f "$LOCK_FILE" ]]; then
        info "Nenhuma sessão ativa."; return
    fi
    local pid
    pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid',0))" 2>/dev/null || echo 0)
    if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
        warn "Encerrando PID $pid..."
        kill "$pid"
        sleep 1
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" || true
        ok "Processo encerrado."
    else
        warn "Processo não encontrado, apenas limpando o lock."
    fi
    rm -f "$LOCK_FILE"
    ok "Lock removido."
}

cmd_unlock() {
    if [[ -f "$LOCK_FILE" ]]; then
        rm -f "$LOCK_FILE"
        ok "Lock removido."
    else
        info "Nenhum lock ativo."
    fi
}

cmd_unblock() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    local tasks_file="$SQUIRE_STATE_ROOT/projects/$project/tasks.json"
    if [[ ! -f "$tasks_file" ]]; then
        error "tasks.json não encontrado para '$project'"; exit 1
    fi
    python3 - "$tasks_file" "$@" << 'PYEOF'
import json, sys
from pathlib import Path

tasks_file = Path(sys.argv[1])
target_ids = set(sys.argv[2:])  # IDs opcionais; vazio = todos bloqueados

data = json.loads(tasks_file.read_text())
count = 0
for t in data["tasks"]:
    if t["status"] == "blocked":
        if target_ids and t["id"] not in target_ids:
            continue
        t["status"] = "pending"
        t["attempts"] = 0
        t["homologation_attempt"] = 0
        t.pop("homologation_result", None)
        # Limpa histórico de loops para evitar que a detecção dispare imediatamente
        t["rejection_summaries"] = []
        t["no_progress_streak"] = 0
        count += 1
        print(f"  ✓ {t['id']} → pending  ({t['title']})")

tasks_file.write_text(json.dumps(data, ensure_ascii=False, indent=2))
print(f"\n{count} task(s) desbloqueada(s).")
PYEOF
}

cmd_reset() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi

    local proj_dir="$SQUIRE_STATE_ROOT/projects/$project"
    local project_file="$proj_dir/project.json"
    local tasks_file="$proj_dir/tasks.json"

    [[ -f "$project_file" ]] || { error "project.json não encontrado para '$project'"; exit 1; }
    [[ -f "$tasks_file" ]]   || { error "tasks.json não encontrado para '$project'"; exit 1; }

    local repo_path
    repo_path=$(python3 -c "import json; print(json.load(open('$project_file')).get('repo_path',''))" 2>/dev/null)

    # Resetar tasks (todas ou apenas as especificadas por ID)
    python3 - "$tasks_file" "$@" << 'PYEOF'
import json, sys
from pathlib import Path

tasks_file = Path(sys.argv[1])
target_ids = set(sys.argv[2:])  # IDs opcionais; vazio = todas as tasks

data = json.loads(tasks_file.read_text())
count = 0
for t in data["tasks"]:
    if target_ids and t["id"] not in target_ids:
        continue
    t["status"] = "pending"
    t["attempts"] = 0
    t["homologation_attempt"] = 0
    t["homologation_result"] = None
    t["rejection_summaries"] = []
    t["no_progress_streak"] = 0
    t["claude_code_assisted"] = False
    count += 1
    print(f"  ✓ {t['id']} → pending  ({t['title']})")

tasks_file.write_text(json.dumps(data, ensure_ascii=False, indent=2))
print(f"\n{count} task(s) resetada(s).")
PYEOF

    # Resetar cursor no checkpoint (evita estado inconsistente após reset de tasks)
    local checkpoint_file="$proj_dir/checkpoint.json"
    if [[ -f "$checkpoint_file" ]]; then
        python3 - "$checkpoint_file" << 'PYEOF'
import json, sys
from pathlib import Path

cp_file = Path(sys.argv[1])
data = json.loads(cp_file.read_text())
cursor = data.get("cursor", {})
cursor["current_task_id"] = None
cursor["current_subtask_id"] = None
cursor["step"] = "planning"
cursor["attempt"] = 0
cursor["homologation_attempt"] = 0
data["cursor"] = cursor
cp_file.write_text(json.dumps(data, ensure_ascii=False, indent=2))
print("  ✓ checkpoint cursor resetado")
PYEOF
    fi

    # Limpar estado git do repo (staged + working tree)
    if [[ -n "$repo_path" ]] && [[ -d "$repo_path/.git" ]]; then
        warn "Limpando git state em $repo_path"
        git -C "$repo_path" reset HEAD -- . 2>/dev/null || true
        git -C "$repo_path" checkout -- . 2>/dev/null \
            && ok "git checkout -- . OK" \
            || warn "Nada para limpar no git (working tree já limpo)"
    elif [[ -n "$repo_path" ]]; then
        warn "repo_path '$repo_path' não é um repositório git — pulando limpeza"
    fi
}

cmd_new() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]] || [[ "$project" == --* ]]; then
        error "Uso: squire new <project-id> [--repo <path>] [--name <nome>] [--stack <csv>] [--backend aider|litellm]"
        exit 1
    fi

    local repo_path="" name="" stack="typescript" backend="aider"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)    repo_path="$2"; shift 2 ;;
            --name)    name="$2";      shift 2 ;;
            --stack)   stack="$2";     shift 2 ;;
            --backend) backend="$2";   shift 2 ;;
            *) error "Opção desconhecida: $1"; exit 1 ;;
        esac
    done

    # Defaults
    [[ -z "$name" ]]      && name="$project"
    [[ -z "$repo_path" ]] && repo_path="/home/ai-debian/projects/$project"

    local proj_dir="$SQUIRE_STATE_ROOT/projects/$project"
    if [[ -d "$proj_dir" ]]; then
        error "Projeto '$project' já existe em $proj_dir"
        exit 1
    fi

    mkdir -p "$proj_dir"

    # Converter stack CSV em array JSON
    local stack_json
    stack_json=$(python3 -c "
import json, sys
items = [s.strip() for s in sys.argv[1].split(',') if s.strip()]
print(json.dumps(items))
" "$stack")

    # project.json
    python3 - "$proj_dir/project.json" "$project" "$name" "$repo_path" "$stack_json" "$backend" << 'PYEOF'
import json, sys, datetime
path, pid, name, repo, stack_json, backend = sys.argv[1:]
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
data = {
    "id": pid,
    "name": name,
    "description": "",
    "repo_path": repo,
    "stack": json.loads(stack_json),
    "status": "planning",
    "created_at": now,
    "updated_at": now,
    "current_task_id": None,
    "coding_backend": backend,
}
open(path, "w").write(json.dumps(data, ensure_ascii=False, indent=2))
PYEOF

    # tasks.json — template comentado
    cat > "$proj_dir/tasks.json" << 'TASKEOF'
{
  "tasks": [
    {
      "id": "task-001",
      "title": "Setup inicial",
      "description": "Descreva aqui o que deve ser feito. Seja específico: quais arquivos criar, qual comportamento esperado, quais testes devem passar.",
      "status": "pending",
      "max_attempts": 10,
      "max_homologation_attempts": 5,
      "skip_homologation": false,
      "subtasks": []
    }
  ]
}
TASKEOF

    local editor="${EDITOR:-nano}"
    ok "Projeto '$project' criado em $proj_dir"
    echo ""

    # Perguntar se deseja usar 'squire tasks plan' para criar as tasks iniciais
    echo -e -n "  Deseja planejar as tasks agora com Claude? [y/N] "
    local resposta
    read -r resposta
    if [[ "${resposta,,}" == "y" ]]; then
        echo ""
        SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
            "$SQUIRE_VENV" -u "$SQUIRE_DIR/tasks_cli.py" plan "$project"
        echo ""
    fi

    echo -e "  ${BOLD}Próximos passos:${RESET}"
    echo -e "  1. Edite as tasks:   ${CYAN}$editor $proj_dir/tasks.json${RESET}"
    echo -e "  2. Crie o repo:      ${CYAN}mkdir -p $repo_path && cd $repo_path && git init${RESET}"
    echo -e "  3. Execute:          ${CYAN}squire run $project${RESET}"
    echo ""
    echo -e "  Ajuste a descrição do projeto:"
    echo -e "  ${CYAN}$editor $proj_dir/project.json${RESET}"
}

cmd_projects() {
    bold "Projetos disponíveis:"
    list_projects | sed 's/^/  /'
}

cmd_tasks_help() {
    bold "squire tasks — gerenciamento de tasks"
    echo ""
    echo -e "  ${CYAN}squire tasks${RESET} <projeto>                    Lista tasks (alias de list)"
    echo -e "  ${CYAN}squire tasks list${RESET}   <projeto>              Lista tasks com status visual"
    echo -e "  ${CYAN}squire tasks add${RESET}    <projeto> --title \"...\" [--desc \"...\"] [--id \"...\"] [--skip-homolog] [--max N] [--max-homolog N]"
    echo -e "  ${CYAN}squire tasks edit${RESET}   <projeto> [<id>]       Edita no \$EDITOR (sem id = tasks.json inteiro)"
    echo -e "  ${CYAN}squire tasks rm${RESET}     <projeto> <id>         Remove task por ID"
    echo -e "  ${CYAN}squire tasks split${RESET}  <projeto> <id>         Claude subdivide task em subtasks"
    echo -e "  ${CYAN}squire tasks plan${RESET}   <projeto> [--desc \"...\"]  Claude planeja tasks (rascunho + refinamento interativo)"
    echo ""
    echo -e "  Exemplos:"
    echo -e "    squire tasks pilotinho"
    echo -e "    squire tasks add meu-app --title \"Setup inicial\" --skip-homolog"
    echo -e "    squire tasks plan meu-app --desc \"API REST para usuários\""
    echo -e "    squire tasks split meu-app task-003"
}

cmd_tasks() {
    local subcmd="${1:-}"
    case "$subcmd" in
        list|add|edit|rm|split|plan)
            shift
            SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
                "$SQUIRE_VENV" -u "$SQUIRE_DIR/tasks_cli.py" "$subcmd" "$@"
            ;;
        help|-h|--help)
            cmd_tasks_help
            ;;
        "")
            error "Projeto obrigatório."
            echo ""
            cmd_tasks_help
            exit 1
            ;;
        *)
            # Não é subcmd reconhecido → assume projeto, default=list
            SQUIRE_STATE_ROOT="$SQUIRE_STATE_ROOT" \
                "$SQUIRE_VENV" -u "$SQUIRE_DIR/tasks_cli.py" list "$@"
            ;;
    esac
}

cmd_help() {
    bold "squire — CLI"
    echo ""
    echo -e "  ${CYAN}squire run${RESET} <projeto>             Executa em foreground"
    echo -e "  ${CYAN}squire run${RESET} <projeto> --quiet    Executa sem preview de prompts"
    echo -e "  ${CYAN}squire bg${RESET}  <projeto>             Executa em background (nohup)"
    echo -e "  ${CYAN}squire resume${RESET} <projeto>             Retoma do checkpoint em foreground"
    echo -e "  ${CYAN}squire resume${RESET} <projeto> bg          Retoma em background"
    echo -e "  ${CYAN}squire resume${RESET} <projeto> [bg] --quiet  Retoma sem preview de prompts"
    echo -e "  ${CYAN}squire dry${RESET} <projeto>             Dry-run (sem execução real)"
    echo -e "  ${CYAN}squire log${RESET}                 Acompanha o log do background"
    echo -e "  ${CYAN}squire status${RESET}              Mostra estado de sessão/projetos/rate-limit"
    echo -e "  ${CYAN}squire kill${RESET}                Encerra o processo da sessão ativa e remove o lock"
    echo -e "  ${CYAN}squire unlock${RESET}              Remove o session.lock residual deixado por crash (não mata processo)"
    echo -e "  ${CYAN}squire unblock${RESET} <projeto> [id...]"
    echo -e "                           Retoma tasks com status 'blocked' → pending (mantém o código no repo)"
    echo -e "  ${CYAN}squire reset${RESET}   <projeto> [id...]"
    echo -e "                           Reinicia tasks do zero → pending + limpa o working tree git (descarta código não-commitado)"
    echo -e "  ${CYAN}squire tasks${RESET}   <projeto>              Lista tasks (alias de list)"
    echo -e "  ${CYAN}squire tasks list${RESET}   <projeto>          Lista tasks com status visual"
    echo -e "  ${CYAN}squire tasks add${RESET}    <projeto> --title \"...\" [--desc \"...\"] [--id \"...\"] [--skip-homolog] [--max N]"
    echo -e "  ${CYAN}squire tasks edit${RESET}   <projeto> [<id>]   Edita task no \$EDITOR"
    echo -e "  ${CYAN}squire tasks rm${RESET}     <projeto> <id>     Remove task por ID"
    echo -e "  ${CYAN}squire tasks split${RESET}  <projeto> <id>     Claude subdivide task em subtasks"
    echo -e "  ${CYAN}squire tasks plan${RESET}   <projeto> [--desc \"...\"]  Claude planeja tasks (rascunho + refinamento)"
    echo -e "  ${CYAN}squire projects${RESET}            Lista projetos disponíveis"
    echo -e "  ${CYAN}squire new${RESET} <projeto>              Cria projeto novo"
    echo -e "  ${CYAN}squire new${RESET} <projeto> --repo <path> --name <nome> --stack <csv> --backend <aider|litellm>"
    echo ""
    echo -e "  Variável de ambiente: ${YELLOW}SQUIRE_STATE_ROOT${RESET} (padrão: $SQUIRE_STATE_ROOT)"
    echo ""
    echo -e "  Exemplos:"
    echo -e "    squire new meu-app --repo /home/ai-debian/projects/meu-app --stack typescript,nextjs"
    echo -e "    squire run orchestrator-dashboard"
    echo -e "    squire bg  orchestrator-dashboard"
    echo -e "    squire log"
    echo -e "    squire status"
    echo -e "    squire kill"
}

# ── Dispatcher ─────────────────────────────────────────────────────
CMD="${1:-help}"; shift || true

case "$CMD" in
    run)      cmd_run "$@" ;;
    bg)       cmd_bg "$@" ;;
    resume)   cmd_resume "$@" ;;
    dry)      cmd_dry "$@" ;;
    log)      cmd_log ;;
    status)   cmd_status ;;
    kill)     cmd_kill ;;
    unlock)   cmd_unlock ;;
    unblock)  cmd_unblock "$@" ;;
    reset)    cmd_reset "$@" ;;
    projects) cmd_projects ;;
    new)      cmd_new "$@" ;;
    tasks)    cmd_tasks "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        error "Comando desconhecido: '$CMD'"
        echo ""
        cmd_help
        exit 1
        ;;
esac
