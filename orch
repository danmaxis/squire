#!/usr/bin/env bash
# orch — CLI wrapper para o orquestrador
# Uso: orch <comando> [projeto] [opções]

set -euo pipefail

# Resolve o diretório real do script (segue symlinks)
ORCH_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ORCH_VENV="$ORCH_DIR/.venv/bin/python"
ORCH_STATE_ROOT="${ORCH_STATE_ROOT:-/home/ai-debian/orchestrator-state}"
ORCH_LOG="/tmp/orch.log"
LOCK_FILE="$ORCH_STATE_ROOT/session.lock"

# ── Cores ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()  { echo -e "${CYAN}→${RESET} $*"; }
ok()    { echo -e "${GREEN}✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET} $*"; }
error() { echo -e "${RED}✗${RESET} $*" >&2; }
bold()  { echo -e "${BOLD}$*${RESET}"; }

# ── Helpers ────────────────────────────────────────────────────────
list_projects() {
    ls "$ORCH_STATE_ROOT/projects/" 2>/dev/null || echo "(nenhum projeto encontrado)"
}

check_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local pid
        pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid', 0))" 2>/dev/null || echo 0)
        if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
            warn "Sessão ativa (PID $pid). Use 'orch kill' para encerrar."
            return 1
        else
            warn "Lock residual encontrado (processo morto). Limpando..."
            rm -f "$LOCK_FILE"
        fi
    fi
    return 0
}

run_orch() {
    local project="$1"; shift
    ORCH_STATE_ROOT="$ORCH_STATE_ROOT" \
        "$ORCH_VENV" -u "$ORCH_DIR/orchestrator.py" "$project" "$@"
}

# ── Comandos ───────────────────────────────────────────────────────

cmd_run() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1
    info "Iniciando orquestrador para '$project'..."
    run_orch "$project" "$@"
}

cmd_resume() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1

    # Detectar modo bg e flag --quiet nos args restantes
    local bg=false
    local extra=()
    for arg in "$@"; do
        if [[ "$arg" == "bg" ]]; then bg=true
        else extra+=("$arg")
        fi
    done

    if $bg; then
        info "Retomando '$project' em background → $ORCH_LOG"
        ORCH_STATE_ROOT="$ORCH_STATE_ROOT" \
            nohup "$ORCH_VENV" -u "$ORCH_DIR/orchestrator.py" "$project" --resume "${extra[@]+"${extra[@]}"}" \
            > "$ORCH_LOG" 2>&1 &
        local pid=$!
        ok "Rodando com PID $pid"
        echo -e "  Acompanhe com: ${CYAN}orch log${RESET}"
    else
        info "Retomando '$project' do checkpoint..."
        run_orch "$project" --resume "${extra[@]+"${extra[@]}"}"
    fi
}

cmd_bg() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    check_lock || exit 1
    info "Iniciando '$project' em background → $ORCH_LOG"
    ORCH_STATE_ROOT="$ORCH_STATE_ROOT" \
        nohup "$ORCH_VENV" -u "$ORCH_DIR/orchestrator.py" "$project" "$@" \
        > "$ORCH_LOG" 2>&1 &
    local pid=$!
    ok "Rodando com PID $pid"
    echo -e "  Acompanhe com: ${CYAN}orch log${RESET}"
}

cmd_dry() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    info "Dry-run para '$project' (sem execução real)..."
    run_orch "$project" --dry-run "$@"
}

cmd_log() {
    if [[ ! -f "$ORCH_LOG" ]]; then
        error "Nenhum log encontrado em $ORCH_LOG"; exit 1
    fi
    tail -f "$ORCH_LOG"
}

cmd_status() {
    bold "=== Estado do orquestrador ==="
    echo ""

    # Lock
    if [[ -f "$LOCK_FILE" ]]; then
        local pid holder
        pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid',0))" 2>/dev/null || echo 0)
        holder=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('holder','?'))" 2>/dev/null || echo "?")
        if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
            ok "Sessão ativa: $holder (PID $pid)"
        else
            warn "Lock residual (processo morto): $holder"
        fi
    else
        info "Nenhuma sessão ativa"
    fi

    echo ""
    bold "=== Projetos ==="
    for proj_dir in "$ORCH_STATE_ROOT/projects"/*/; do
        local proj
        proj=$(basename "$proj_dir")
        local status tasks_done tasks_total
        status=$(python3 -c "
import json, pathlib
p = pathlib.Path('$proj_dir/project.json')
if p.exists():
    d = json.loads(p.read_text())
    print(d.get('status','?'))
else:
    print('?')
" 2>/dev/null || echo "?")
        tasks_done=$(python3 -c "
import json, pathlib
p = pathlib.Path('$proj_dir/tasks.json')
if p.exists():
    d = json.loads(p.read_text())
    done = sum(1 for t in d.get('tasks',[]) if t.get('status') == 'completed')
    total = len(d.get('tasks',[]))
    print(f'{done}/{total}')
else:
    print('?/?')
" 2>/dev/null || echo "?/?")
        echo -e "  ${BOLD}$proj${RESET}  status=${CYAN}$status${RESET}  tasks=${tasks_done}"
    done

    echo ""
    bold "=== Rate limit ==="
    python3 -c "
import json, pathlib, datetime
for proj_dir in pathlib.Path('$ORCH_STATE_ROOT/projects').iterdir():
    cp = proj_dir / 'checkpoint.json'
    if not cp.exists(): continue
    d = json.loads(cp.read_text())
    rl = d.get('rate_limit', {})
    calls = rl.get('claude_code_calls_this_window', 0)
    maxc  = rl.get('max_calls_per_window', 10)
    ws    = rl.get('window_started_at', '')
    wm    = rl.get('window_duration_minutes', 30)
    if ws:
        wst = datetime.datetime.fromisoformat(ws)
        exp = wst + datetime.timedelta(minutes=wm)
        rem = max(0, (exp - datetime.datetime.utcnow()).total_seconds())
        print(f'  {proj_dir.name}: {calls}/{maxc} calls  (janela reseta em {rem/60:.1f}min)')
    else:
        print(f'  {proj_dir.name}: {calls}/{maxc} calls')
" 2>/dev/null || info "Sem checkpoint disponível"
}

cmd_kill() {
    if [[ ! -f "$LOCK_FILE" ]]; then
        info "Nenhuma sessão ativa."; return
    fi
    local pid
    pid=$(python3 -c "import json; d=json.load(open('$LOCK_FILE')); print(d.get('pid',0))" 2>/dev/null || echo 0)
    if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
        warn "Encerrando PID $pid..."
        kill "$pid"
        sleep 1
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" || true
        ok "Processo encerrado."
    else
        warn "Processo não encontrado, apenas limpando o lock."
    fi
    rm -f "$LOCK_FILE"
    ok "Lock removido."
}

cmd_unlock() {
    if [[ -f "$LOCK_FILE" ]]; then
        rm -f "$LOCK_FILE"
        ok "Lock removido."
    else
        info "Nenhum lock ativo."
    fi
}

cmd_unblock() {
    local project="${1:-}"; shift || true
    if [[ -z "$project" ]]; then
        error "Projeto obrigatório. Projetos disponíveis:"; list_projects; exit 1
    fi
    local tasks_file="$ORCH_STATE_ROOT/projects/$project/tasks.json"
    if [[ ! -f "$tasks_file" ]]; then
        error "tasks.json não encontrado para '$project'"; exit 1
    fi
    python3 - "$tasks_file" "$@" << 'PYEOF'
import json, sys
from pathlib import Path

tasks_file = Path(sys.argv[1])
target_ids = set(sys.argv[2:])  # IDs opcionais; vazio = todos bloqueados

data = json.loads(tasks_file.read_text())
count = 0
for t in data["tasks"]:
    if t["status"] == "blocked":
        if target_ids and t["id"] not in target_ids:
            continue
        t["status"] = "pending"
        t["attempts"] = 0
        t["homologation_attempt"] = 0
        t.pop("homologation_result", None)
        # Limpa histórico de loops para evitar que a detecção dispare imediatamente
        t["rejection_summaries"] = []
        t["no_progress_streak"] = 0
        count += 1
        print(f"  ✓ {t['id']} → pending  ({t['title']})")

tasks_file.write_text(json.dumps(data, ensure_ascii=False, indent=2))
print(f"\n{count} task(s) desbloqueada(s).")
PYEOF
}

cmd_projects() {
    bold "Projetos disponíveis:"
    list_projects | sed 's/^/  /'
}

cmd_help() {
    bold "orch — orquestrador CLI"
    echo ""
    echo -e "  ${CYAN}orch run${RESET} <projeto>             Executa em foreground"
    echo -e "  ${CYAN}orch run${RESET} <projeto> --quiet    Executa sem preview de prompts"
    echo -e "  ${CYAN}orch bg${RESET}  <projeto>             Executa em background (nohup)"
    echo -e "  ${CYAN}orch resume${RESET} <projeto>             Retoma do checkpoint em foreground"
    echo -e "  ${CYAN}orch resume${RESET} <projeto> bg          Retoma em background"
    echo -e "  ${CYAN}orch resume${RESET} <projeto> [bg] --quiet  Retoma sem preview de prompts"
    echo -e "  ${CYAN}orch dry${RESET} <projeto>             Dry-run (sem execução real)"
    echo -e "  ${CYAN}orch log${RESET}                 Acompanha o log do background"
    echo -e "  ${CYAN}orch status${RESET}              Mostra estado de sessão/projetos/rate-limit"
    echo -e "  ${CYAN}orch kill${RESET}                Encerra sessão ativa e remove lock"
    echo -e "  ${CYAN}orch unlock${RESET}              Remove lock residual (sem matar processo)"
    echo -e "  ${CYAN}orch unblock${RESET} <projeto> [id...]  Reseta tasks bloqueadas para pending"
    echo -e "  ${CYAN}orch projects${RESET}            Lista projetos disponíveis"
    echo ""
    echo -e "  Variável de ambiente: ${YELLOW}ORCH_STATE_ROOT${RESET} (padrão: $ORCH_STATE_ROOT)"
    echo ""
    echo -e "  Exemplos:"
    echo -e "    orch run orchestrator-dashboard"
    echo -e "    orch bg  orchestrator-dashboard"
    echo -e "    orch log"
    echo -e "    orch status"
    echo -e "    orch kill"
}

# ── Dispatcher ─────────────────────────────────────────────────────
CMD="${1:-help}"; shift || true

case "$CMD" in
    run)      cmd_run "$@" ;;
    bg)       cmd_bg "$@" ;;
    resume)   cmd_resume "$@" ;;
    dry)      cmd_dry "$@" ;;
    log)      cmd_log ;;
    status)   cmd_status ;;
    kill)     cmd_kill ;;
    unlock)   cmd_unlock ;;
    unblock)  cmd_unblock "$@" ;;
    projects) cmd_projects ;;
    help|-h|--help) cmd_help ;;
    *)
        error "Comando desconhecido: '$CMD'"
        echo ""
        cmd_help
        exit 1
        ;;
esac
